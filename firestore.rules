rules_version = '2';
// Regras de segurança — Júlia Marcico Nails
// Troque juliamarcico@gmail.com pelo mesmo e-mail colocado no config.js
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'juliamarcico@gmail.com';
    }

    // Configurações (nome, serviços, horários): todo mundo lê, só a Júlia altera
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Horários ocupados (só data e hora, sem nome de cliente): o link lê para mostrar vagas
    match /ocupados/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['data', 'ini', 'fim']);
      allow update, delete: if isAdmin();
    }

    // Agendamentos: cliente só cria pedido "pendente" e só lê o próprio (pelo código dele)
    match /agendamentos/{id} {
      allow get: if true;
      // a cliente logada vê a lista dos horários da própria conta
      allow list: if isAdmin() || (request.auth != null && resource.data.clienteUid == request.auth.uid);
      allow create: if isAdmin() || (request.resource.data.status == 'pendente'
        && (!('clienteUid' in request.resource.data) || (request.auth != null && request.resource.data.clienteUid == request.auth.uid)));
      allow update, delete: if isAdmin();
    }

    // Conta da cliente (nome, WhatsApp, e-mail): só ela e a Júlia
    match /clientes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Perfil de recompensas: a cliente lê só o dela (pelo WhatsApp); só a Júlia grava
    match /perfis/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Lista de encaixe: cliente só entra na lista; só a Júlia vê
    match /encaixes/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Financeiro: só a Júlia
    match /vendas/{id} {
      allow read, write: if isAdmin();
    }
    match /despesas/{id} {
      allow read, write: if isAdmin();
    }

    // Chat: cada cliente só acessa a própria conversa (código aleatório guardado no aparelho dela)
    match /conversas/{cid} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
      match /msgs/{mid} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }
  }
}
