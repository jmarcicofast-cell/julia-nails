rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function admin() { return signed() && request.auth.token.email == 'juliamarcico@gmail.com' && get(/databases/$(database)/documents/controle/seguranca).data.adminUid == request.auth.uid; }
    function own(d) { return signed() && d.get('clienteUid', '') == request.auth.uid; }
    function access() { return get(/databases/$(database)/documents/clienteAcessos/$(request.auth.uid)).data; }
    function conversation(cid) {
      return signed() && (cid == 'u_' + request.auth.uid || (exists(/databases/$(database)/documents/clienteAcessos/$(request.auth.uid)) && cid in access().get('conversaIds', [])));
    }
    function short(s,n) { return s is string && s.size() <= n; }
    match /config/{id} { allow read: if true; allow write: if admin(); }
    match /controle/{id} { allow read, write: if false; }
    match /agendaDias/{id} { allow read, write: if false; }
    match /clienteAcessos/{uid} { allow read: if admin() || (signed() && request.auth.uid == uid); allow write: if admin(); }
    match /ocupados/{id} { allow read: if true; allow write: if false; }
    match /agendamentos/{id} { allow read: if admin() || own(resource.data); allow write: if false; }
    match /clientes/{uid} {
      allow read: if admin() || (signed() && request.auth.uid == uid);
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','telefone','email','criadoEm'])
        && short(request.resource.data.nome,150) && short(request.resource.data.telefone,30)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.criadoEm is number;
      allow delete: if admin();
    }
    match /perfis/{id} {
      allow get: if admin() || (signed() && (id == 'u_' + request.auth.uid || (exists(/databases/$(database)/documents/clienteAcessos/$(request.auth.uid)) && id == access().get('perfilId',''))));
      allow list, write: if admin();
    }
    match /encaixes/{id} {
      allow create: if admin() || (own(request.resource.data)
        && request.resource.data.keys().hasOnly(['clienteUid','nome','telefone','servicoId','servicoNome','dias','periodo','obs','status','origem','criadoEm'])
        && request.resource.data.status == 'aguardando' && request.resource.data.origem == 'link'
        && short(request.resource.data.nome,150) && short(request.resource.data.telefone,30)
        && short(request.resource.data.obs,500) && short(request.resource.data.servicoId,128)
        && short(request.resource.data.servicoNome,200) && short(request.resource.data.periodo,30)
        && request.resource.data.dias is list && request.resource.data.dias.size() <= 7
        && request.resource.data.criadoEm is number);
      allow read, update, delete: if admin();
    }
    match /vendas/{id} { allow read, write: if admin(); }
    match /despesas/{id} { allow read, write: if admin(); }
    match /conversas/{cid} {
      allow get: if admin() || conversation(cid);
      allow list, delete: if admin();
      allow create, update: if admin() || (conversation(cid)
        && own(request.resource.data)
        && request.resource.data.keys().hasOnly(['clienteUid','nome','telefone','ultimaMsg','ultimaDe','atualizadoEm','naoLidaAdmin','naoLidaCliente'])
        && short(request.resource.data.nome,150) && short(request.resource.data.telefone,30)
        && short(request.resource.data.ultimaMsg,2000)
        && request.resource.data.ultimaDe in ['cliente','admin']
        && request.resource.data.atualizadoEm is number
        && (request.method == 'create' ? request.resource.data.ultimaDe == 'cliente' : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clienteUid','nome','telefone','ultimaMsg','ultimaDe','atualizadoEm','naoLidaAdmin','naoLidaCliente']))
        && (request.resource.data.get('naoLidaCliente', false) == false)
        && (request.resource.data.ultimaDe == 'cliente' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['naoLidaCliente'])));
      match /msgs/{mid} {
        allow read: if admin() || conversation(cid);
        allow create: if admin() || (conversation(cid)
          && request.resource.data.keys().hasOnly(['de','texto','em'])
          && request.resource.data.de == 'cliente'
          && short(request.resource.data.texto,2000) && request.resource.data.texto.size() > 0
          && request.resource.data.em is number);
        allow update, delete: if admin();
      }
    }
  }
}
